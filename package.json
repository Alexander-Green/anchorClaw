{
  "name": "@alexandrgreen/anchorclaw",
  "version": "0.0.9",
  "description": "OpenClaw Postgres-backed long-term memory plugin",
  "author": "Alexander Green",
  "license": "MIT",
  "homepage": "https://github.com/Alexander-Green/anchorClaw#readme",
  "bugs": {
    "url": "https://github.com/Alexander-Green/anchorClaw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexander-Green/anchorClaw.git"
  },
  "type": "module",
  "files": [
    "dist/",
    "migrations/",
    "assets/",
    "openclaw.plugin.json",
    "NOTICE",
    "README.md",
    "INSTALL.md",
    "ARCHITECTURE.md",
    "docs/integrations/",
    "package.json"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.12"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "openclaw": "2026.5.28",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@alexandrgreen/anchorclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12"
    },
    "compat": {
      "pluginApi": ">=2026.5.12"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
