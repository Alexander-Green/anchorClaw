{
  "id": "anchorclaw",
  "commandAliases": [
    {
      "name": "anchorclaw"
    }
  ],
  "activation": {
    "onStartup": false
  },
  "kind": "memory",
  "contracts": {
    "tools": ["memory_search", "memory_get", "memory_log", "memory_store", "memory_forget", "memory_status"]
  },
  "uiHints": {
    "sessions": {
      "label": "Sessions",
      "help": "Sessions corpus indexing and visibility settings",
      "advanced": true
    },
    "sessions.search": {
      "label": "Sessions Search",
      "help": "Opt in to the Postgres-backed sessions search corpus.",
      "advanced": true
    },
    "sessions.search.enabled": {
      "label": "Sessions Search Enabled",
      "help": "Expose and maintain the sessions corpus. Disabled by default.",
      "advanced": true
    },
    "sessions.visibility": {
      "label": "Sessions Visibility",
      "placeholder": "current",
      "help": "Visibility scope for sessions corpus: current (default), off, or visible (requires visibility guard support).",
      "advanced": true
    },
    "sessions.sync": {
      "label": "Sessions Delta Sync",
      "help": "Thresholds controlling when transcript updates trigger sessions index sync.",
      "advanced": true
    },
    "sessions.sync.deltaBytes": {
      "label": "Delta Bytes",
      "placeholder": "100000",
      "help": "Minimum appended bytes before reindexing sessions transcripts.",
      "advanced": true
    },
    "sessions.sync.deltaMessages": {
      "label": "Delta Messages",
      "placeholder": "50",
      "help": "Minimum appended message records before reindexing sessions transcripts.",
      "advanced": true
    },
    "identity": {
      "label": "Identity",
      "help": "Stable owner identity for memory scoping",
      "advanced": true
    },
    "identity.externalId": {
      "label": "External Identity",
      "placeholder": "family-main-01",
      "help": "Stable identity key (max 20 chars). Recommended for Docker/production to avoid memory scope drift.",
      "advanced": true
    },
    "debug": {
      "label": "Debug",
      "help": "Temporary diagnostic toggles for AnchorClaw runtime behavior.",
      "advanced": true
    },
    "debug.promptLogEnabled": {
      "label": "Prompt Log Enabled",
      "help": "Log daily/session startup prompt injection decisions and a bounded preview of the injected AnchorClaw context.",
      "advanced": true
    },
    "postgres": {
      "label": "Postgres",
      "help": "Postgres connection settings for AnchorClaw memory storage"
    },
    "postgres.host": {
      "label": "Host",
      "placeholder": "localhost",
      "help": "Postgres host"
    },
    "postgres.port": {
      "label": "Port",
      "placeholder": "5432",
      "help": "Postgres port"
    },
    "postgres.database": {
      "label": "Database",
      "placeholder": "anchorclaw",
      "help": "Postgres database name"
    },
    "postgres.schema": {
      "label": "Schema",
      "placeholder": "memory",
      "help": "Optional Postgres schema for AnchorClaw tables (recommended to avoid polluting public)",
      "advanced": true
    },
    "postgres.user": {
      "label": "User",
      "placeholder": "postgres",
      "help": "Postgres user"
    },
    "postgres.password": {
      "label": "Password",
      "sensitive": true,
      "placeholder": "${ANCHORCLAW_DB_PASSWORD}",
      "help": "Postgres password; supports ${ENV_VAR} values"
    },
    "postgres.ssl": {
      "label": "SSL",
      "help": "Enable SSL for Postgres connection",
      "advanced": true
    },
    "postgres.sslMode": {
      "label": "SSL Mode",
      "placeholder": "verify-full",
      "help": "SSL mode: disable, require (no cert verification), or verify-full (verify server certificate)",
      "advanced": true
    },
    "postgres.sslCa": {
      "label": "SSL CA",
      "placeholder": "${ANCHORCLAW_DB_SSL_CA_PEM}",
      "help": "Optional CA PEM bundle for verify-full; supports ${ENV_VAR} values",
      "advanced": true
    },
    "postgres.pool": {
      "label": "Pool",
      "help": "Connection pool settings",
      "advanced": true
    },
    "postgres.pool.max": {
      "label": "Max Connections",
      "placeholder": "10",
      "help": "Maximum number of connections in the pool",
      "advanced": true
    },
    "postgres.pool.connectionTimeoutMs": {
      "label": "Connect Timeout (ms)",
      "placeholder": "5000",
      "help": "Time to wait for a connection before failing",
      "advanced": true
    },
    "postgres.pool.idleTimeoutMs": {
      "label": "Idle Timeout (ms)",
      "placeholder": "30000",
      "help": "Time before an idle connection is closed",
      "advanced": true
    },
    "maintenance": {
      "label": "Maintenance",
      "help": "Background daily-to-durable maintenance settings",
      "advanced": true
    },
    "maintenance.workspaceScope": {
      "label": "Workspace Scope",
      "help": "Which OpenClaw workspace set the maintenance extractor should process",
      "advanced": true
    },
    "maintenance.workspaceScope.mode": {
      "label": "Scope Mode",
      "placeholder": "default-agent",
      "help": "default-agent, all-agent-workspaces, or agents",
      "advanced": true
    },
    "maintenance.workspaceScope.agents": {
      "label": "Scope Agents",
      "help": "Explicit agent IDs when scope mode is agents",
      "advanced": true
    },
    "limits": {
      "label": "Limits",
      "help": "Safety limits for memory tools",
      "advanced": true
    },
    "limits.maxResults": {
      "label": "Max Results",
      "placeholder": "10",
      "help": "Maximum search results to return (cap: 10)",
      "advanced": true
    },
    "limits.getMaxChars": {
      "label": "Get Max Chars",
      "placeholder": "12000",
      "help": "Maximum characters returned by memory_get (cap: 12000)",
      "advanced": true
    },
    "limits.getDefaultLines": {
      "label": "Get Default Lines",
      "placeholder": "120",
      "help": "Default lineCount for memory_get when omitted (cap: 120)",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "debug": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "promptLogEnabled": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "sessions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "search": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": ["current", "off", "visible"],
            "default": "current"
          },
          "sync": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deltaBytes": {
                "type": "number",
                "default": 100000,
                "minimum": 0
              },
              "deltaMessages": {
                "type": "number",
                "default": 50,
                "minimum": 0
              }
            }
          }
        }
      },
      "maintenance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "dryRun": {
            "type": "boolean",
            "default": true
          },
          "intervalMinutes": {
            "type": "number",
            "default": 720,
            "minimum": 1,
            "maximum": 1440
          },
          "batchSize": {
            "type": "number",
            "default": 200,
            "minimum": 1,
            "maximum": 2000
          },
          "workspaceScope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["default-agent", "all-agent-workspaces", "agents"]
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "extractor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "maxCandidates": {
                "type": "number",
                "default": 10,
                "minimum": 1,
                "maximum": 100
              },
              "maxCharsPerRun": {
                "type": "number",
                "default": 12000,
                "minimum": 1000,
                "maximum": 200000
              }
            }
          }
        }
      },
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      },
      "postgres": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "oneOf": [
              {
                "type": "number",
                "default": 5432,
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "string",
                "default": "5432",
                "minLength": 1
              }
            ]
          },
          "database": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "user": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string"
          },
          "ssl": {
            "type": "boolean"
          },
          "sslMode": {
            "type": "string",
            "enum": ["disable", "require", "verify-full"]
          },
          "sslCa": {
            "type": "string"
          },
          "pool": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max": {
                "type": "number",
                "default": 10,
                "minimum": 1,
                "maximum": 100
              },
              "connectionTimeoutMs": {
                "type": "number",
                "default": 5000,
                "minimum": 100,
                "maximum": 600000
              },
              "idleTimeoutMs": {
                "type": "number",
                "default": 30000,
                "minimum": 100,
                "maximum": 3600000
              }
            }
          }
        },
        "required": ["host", "database", "user"]
      },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxResults": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 10
          },
          "getMaxChars": {
            "type": "number",
            "default": 12000,
            "minimum": 1000,
            "maximum": 12000
          },
          "getDefaultLines": {
            "type": "number",
            "default": 120,
            "minimum": 10,
            "maximum": 120
          }
        }
      }
    },
    "required": []
  }
}
